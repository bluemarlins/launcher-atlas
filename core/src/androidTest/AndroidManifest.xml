<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver android:name="dev.launcheratlas.core.FixtureWidget" android:label="Atlas fixture" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/fixture_widget" />
        </receiver>
        <receiver android:name="dev.launcheratlas.core.FixtureConfigWidget" android:label="Atlas fixture (configure)" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/fixture_config_widget" />
        </receiver>
        <activity android:name="dev.launcheratlas.core.FixtureConfigurationActivity" android:exported="true" />
        <receiver android:name="dev.launcheratlas.core.FixtureWidgetAction" android:exported="false" />
    </application>
</manifest>
